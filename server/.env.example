# Gujarat Khedut Portal - Environment Variables Template
# Copy this file to .env and fill in your values for production deployment

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gujarat_khedut_portal?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_change_me_in_production

# Admin Master Credentials (Website Owner & Company Members)
ADMIN_PASSWORD=yash
ADMIN_MOBILE=9999999999

# SMS Gateway Configuration: simulator | twilio | msg91 | 2factor
SMS_GATEWAY=simulator

# Twilio (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 India (Optional)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# 2Factor India (Optional)
TWOFACTOR_API_KEY=your_2factor_api_key
TWOFACTOR_SENDER_ID=KHEDUT
